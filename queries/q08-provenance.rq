# Provenance of a consultation written back to the graph (run with: ddxes sparql q08-provenance.rq --with-patient T002456)
# Why is this case an emergency? Which rule fired, on which facts, and which guideline does the rule encode?
PREFIX : <http://example.org/ddx#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?level ?ruleCode ?ruleName ?used ?citation WHERE {
  ?inf a :TriageInference ; :aboutCase ?case ; :inferredTriage ?t ; prov:wasGeneratedBy ?firing .
  ?t rdfs:label ?level .
  ?firing :firedRule ?rule ; prov:used ?u .
  ?rule :code ?ruleCode ; rdfs:label ?ruleName ; dct:source/dct:bibliographicCitation ?citation .
  OPTIONAL { ?u :inferredPathology/rdfs:label ?up . FILTER(lang(?up) = "en") }
  OPTIONAL { ?u :inferredConcept/rdfs:label ?uc }
  OPTIONAL { ?u rdfs:label ?ul . FILTER(lang(?ul) = "en") }
  BIND(COALESCE(?up, ?uc, ?ul, STR(?u)) AS ?used)
}
