# Red-flag rules: never asserted, entailed by OWL 2 RL from the rule structure
#   (∃ asserts.(∃ concludesTriage.{Emergency}) ⊑ RedFlagRule). Run with and without kg/inferred.ttl.
PREFIX : <http://example.org/ddx#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?code ?name ?src WHERE {
  ?rule a :RedFlagRule ; :code ?code ; rdfs:label ?name ; dct:source/:citationKey ?src .
} ORDER BY ?code
