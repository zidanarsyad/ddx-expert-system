    <path d="M95 140V172" stroke="#5E6E7E" stroke-width="1.4" fill="none" marker-end="url(#ah)"/>
    <text x="103" y="161" font-size="9.5" fill="#5E6E7E">dct:source</text>
    <path d="M95 86C95 30 300 22 540 22C574 22 570 50 570 82" stroke="#5E6E7E" stroke-width="1.4" fill="none" marker-end="url(#ah)"/>
    <text x="330" y="17" font-size="9.5" text-anchor="middle" fill="#5E6E7E">premise: … OR coughing up blood</text>
