<section class="newpage">
<h2><span class="n">16</span>Glossary</h2>
{% set terms = [
  ("Abduction", "reasoning from observed effects (symptoms) back to the causes (diseases) that would explain them", 6),
  ("Ablation", "switching off one part of a system to measure what that part contributes", 13),
  ("Antecedent", "a risk factor or piece of history, such as recent surgery or smoking", 2),
  ("Backward chaining", "reasoning from a goal, such as a disease to confirm or rule out, back to the facts and questions it needs", 9),
  ("Certainty factor (CF)", "a number from −1 to +1 on a rule: how much its evidence raises or lowers belief", 7),
  ("Chief complaint", "the main symptom the patient comes with; the consultation starts from it", 9),
  ("Differential diagnosis", "the ranked list of diseases that could explain the patient's findings", 1),
  ("Expected information gain", "how much the answer to a question is expected to reduce the uncertainty about the diagnosis", 9),
  ("Forward chaining", "firing every rule whose conditions hold and repeating until nothing new follows", 6),
  ("Knowledge graph", "knowledge stored as a network of facts, each a subject–predicate–object triple", 4),
  ("Likelihood ratio (LR)", "how much more often a finding occurs with a disease than without it", 7),
  ("Log-odds", "the logarithm of the odds; in log-odds, evidence adds instead of multiplying", 7),
  ("Mapping fidelity", "how completely a rule captures its published criterion: faithful, partial or proxy", 3),
  ("Naive Bayes", "a simple machine-learning classifier that treats findings as independent; the baseline here", 13),
  ("Ontology", "the vocabulary of the graph: classes such as Pathology or Rule, and the properties that link them", 4),
  ("OWL 2 RL", "a rule-based profile of the Web Ontology Language; its reasoner adds the triples that follow from the ontology", 4),
  ("Prior, posterior", "the probability of a disease before and after the patient's evidence is taken into account", 7),
  ("PROV-O", "the W3C vocabulary for provenance: what produced a piece of data, and from what", 11),
  ("RDF triple", "one fact of the graph: subject, predicate, object, such as :PulmonaryEmbolism :hasSymptom :E_45", 4),
  ("Red flag", "a finding that calls for urgent care whatever the final diagnosis", 8),
  ("Set covering", "keeping only the diseases whose profile explains every reported symptom", 6),
  ("SPARQL", "the query language for RDF graphs, as SQL is for tables", 4),
  ("Strata", "the layers in which rules fire; a rule runs only after the rules that produce what it reads", 5),
  ("Top-1 accuracy (GTPA@1)", "the share of patients whose true disease is ranked first", 13),
  ("Triage", "deciding how urgently a patient needs care: Emergency, Urgent, Non-urgent or Self-care", 8),
  ("Turtle (.ttl)", "a plain-text file format for RDF triples", 4),
  ("Under-, over-triage", "a level less, or more, urgent than the patient needs; under-triage is the unsafe error", 8),
  ("Wells score", "a clinical score for the probability of pulmonary embolism (Wells et al., 2000)", 5),
] %}
<dl class="glossary">
  {% for term, dfn, ref in terms %}
  <div><dt>{{ term }}</dt> <dd>{{ dfn }} <span class="ref">§{{ ref }}</span></dd></div>
  {% endfor %}
</dl>
</section>

