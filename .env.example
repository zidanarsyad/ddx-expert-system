# Copy to .env and fill in at least one key to enable the optional free-text intake (ddxes intake, web UI).
# The providers are tried in this order; the first one with a key that answers is used.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b              (default; then openai/gpt-oss-120b)
# Google AI Studio (Gemini, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# OpenRouter (free models end in ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
