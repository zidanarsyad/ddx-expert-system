:Rule_KB-COVER a :RuleSchema ;
    rdfs:label "Parsimonious set covering"@en ;
    :code "KB-COVER" ;
    :ruleText "IF a symptom is present AND pathology d is not characterizedBy it THEN d is excluded (unless no pathology explains every symptom)."@en ;
    dct:source :Src_reggia1983 .

:Rule_KB-EVIDENCE a :RuleSchema ;
    rdfs:label "Evidence strength of a knowledge-base link"@en ;
    :code "KB-EVIDENCE" ;
    :ruleText "IF feature f of the profile of d is present (absent) THEN d with CF = Heckerman(lr), lr from :EvidenceStrength."@en ;
    dct:source :Src_heckerman1986 .

:Rule_KB-SEVERITY a :RuleSchema ;
    rdfs:label "Severity triage"@en ;
    :code "KB-SEVERITY" ;
    :ruleText "IF P(d) >= threshold THEN triage level from the DDXPlus severity of d (1 Emergency, 2 Urgent, 3-4 Non-urgent, 5 Self-care)."@en ;
    dct:source :Src_ddxplus2022 .

