                                    :onEvidence :E_181 ] [ a :EvidencePresent ;
                                    :onEvidence :E_91 ] ) ] ) ] ;
    :ruleIndex 91 ;
    :ruleText "IF age < 6 AND High pitched sound when breathing in AND (Whooping cough OR Symptoms more prominent at night OR Nasal congestion or a clear runny nose OR Fever (either felt or measured with a thermometer)) THEN Croup (CF +0.70)"@en ;
    :salience 0 ;
    :usesEvidence :E_181,
        :E_194,
        :E_202,
        :E_219,
        :E_91 ;
