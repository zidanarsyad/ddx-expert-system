:Rule_D-EBO-1 a :DiagnosticRule ;
    rdfs:label "Ebola suspected case: fever and contact with a case (WHO 2014)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Ebola ] ;
    :certaintyFactor 0.9 ;
    :code "D-EBO-1" ;
    :mappingFidelity "faithful" ;
