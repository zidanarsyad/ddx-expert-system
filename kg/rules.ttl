                                    :onEvidence :E_172 ] [ a :EvidencePresent ;
                                    :onEvidence :E_50 ] ) ] ) ] ;
    :ruleIndex 128 ;
    :ruleText "IF Orbital, supraorbital or temporal pain AND Severe pain (intensity >= 7/10) AND (Your eyes produce excessive tears OR Diffuse (widespread) redness in one or both eyes OR Nasal congestion or a clear runny nose OR Hard time opening/raising one or both eyelids OR Significantly increased sweating) THEN Cluster headache (CF +0.80)"@en ;
