    :citationKey "clancey1983" ;
    dct:bibliographicCitation "Clancey WJ (1983). The epistemology of a rule-based expert system: a framework for explanation. Artificial Intelligence 20(3):215-251." ;
    bibo:doi "10.1016/0004-3702(83)90008-5" ;
    rdfs:seeAlso <https://doi.org/10.1016/0004-3702(83)90008-5> .

