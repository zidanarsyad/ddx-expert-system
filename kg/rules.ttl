                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_45 ] [ a :EvidencePresent ;
                                    :onEvidence :E_162 ] ) ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_91 ] [ a :EvidencePresent ;
                                    :onEvidence :E_50 ] ) ] ) ] ;
    :ruleIndex 108 ;
    :ruleText "IF Cough AND (Coughing up blood OR Involuntary weight loss over the last 3 months) AND (Fever (either felt or measured with a thermometer) OR Significantly increased sweating) THEN Tuberculosis (CF +0.50)"@en ;
