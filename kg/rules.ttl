:Rule_D-ANA-1 a :DiagnosticRule ;
    rdfs:label "Anaphylaxis: allergen exposure with two organ systems (Sampson criterion 2)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Anaphylaxis ] ;
    :certaintyFactor 0.9 ;
    :code "D-ANA-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_42 ] [ a :AtLeast ;
                        :minCount 2 ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_SkinMucosalInvolvement ] [ a :ConceptHolds ;
                                    :onConcept :C_RespiratoryCompromise ] [ a :ConceptHolds ;
                                    :onConcept :C_HypotensionSymptoms ] [ a :ConceptHolds ;
                                    :onConcept :C_GastrointestinalSymptoms ] ) ] ) ] ;
    :ruleIndex 62 ;
    :ruleText "IF In contact with or ate something that you have an allergy to AND at least 2 of [Skin or mucosal involvement (rash, itch, angio-oedema); Respiratory compromise (dyspnoea, wheeze, stridor, choking); Symptoms of reduced blood pressure (near-syncope, syncope); Gastrointestinal symptoms (nausea, vomiting, diarrhoea, cramps)] THEN Anaphylaxis (CF +0.90)"@en ;
    :salience 0 ;
    :usesConcept :C_GastrointestinalSymptoms,
        :C_HypotensionSymptoms,
        :C_RespiratoryCompromise,
        :C_SkinMucosalInvolvement ;
    :usesEvidence :E_42 ;
    dct:source :Src_sampson2006 ;
    rdfs:comment "Sampson: >= 2 of skin-mucosa, respiratory compromise, reduced blood pressure, persistent GI symptoms, rapidly after a likely allergen; onset timing is not asked."@en .

:Rule_D-ANA-2 a :DiagnosticRule ;
    rdfs:label "Anaphylaxis: skin involvement with respiratory or circulatory compromise (Sampson criterion 1)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Anaphylaxis ] ;
    :certaintyFactor 0.5 ;
    :code "D-ANA-2" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_SkinMucosalInvolvement ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_RespiratoryCompromise ] [ a :ConceptHolds ;
                                    :onConcept :C_HypotensionSymptoms ] ) ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_187 ] ] ) ] ;
    :ruleIndex 63 ;
    :ruleText "IF Skin or mucosal involvement (rash, itch, angio-oedema) AND (Respiratory compromise (dyspnoea, wheeze, stridor, choking) OR Symptoms of reduced blood pressure (near-syncope, syncope)) AND NOT Eat dark-fleshed fish (such as tuna) or Swiss cheese before the reaction occurred THEN Anaphylaxis (CF +0.50)"@en ;
    :salience 0 ;
    :usesConcept :C_HypotensionSymptoms,
        :C_RespiratoryCompromise,
        :C_SkinMucosalInvolvement ;
    :usesEvidence :E_187 ;
    dct:source :Src_sampson2006 .

:Rule_D-ANA-3 a :DiagnosticRule ;
    rdfs:label "Anaphylaxis: known severe allergy or atopy with exposure"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Anaphylaxis ] ;
    :certaintyFactor 0.2 ;
    :code "D-ANA-3" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_42 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_12 ] [ a :EvidencePresent ;
                                    :onEvidence :E_226 ] ) ] ) ] ;
    :ruleIndex 64 ;
    :ruleText "IF In contact with or ate something that you have an allergy to AND (Known severe food allergy OR More likely to develop common allergies than the general population) THEN Anaphylaxis (CF +0.20)"@en ;
    :salience 0 ;
    :usesEvidence :E_12,
        :E_226,
        :E_42 ;
    dct:source :Src_cardona2020 .

