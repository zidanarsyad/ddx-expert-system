            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :EvidencePresent ;
                        :onEvidence :E_73 ] ) ] ;
    :ruleIndex 124 ;
    :ruleText "IF Fever (either felt or measured with a thermometer) AND In the last month, have you been in contact with anyone infected with the Ebola virus THEN Ebola (CF +0.90)"@en ;
