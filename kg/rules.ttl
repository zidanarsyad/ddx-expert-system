:Rule_D-SAR-1 a :DiagnosticRule ;
    rdfs:label "Sarcoidosis: eye redness, rash or joint pain with adenopathy and dyspnoea"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Sarcoidosis ] ;
    :certaintyFactor 0.5 ;
    :code "D-SAR-1" ;
    :mappingFidelity "faithful" ;
