    :usesScore :Score_CRB65 ;
    dct:source :Src_lim2003 .

:Rule_T-EBOLA a :TriageRule ;
    rdfs:label "Suspected Ebola: emergency isolation"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Emergency ] ;
    :certaintyFactor 0.95 ;
    :code "T-EBOLA" ;
    :mappingFidelity "faithful" ;
    :premise [ a :BeliefAtLeast ;
            :onPathology :Ebola ;
            :threshold 0.5 ] ;
    :ruleIndex 158 ;
    :ruleText "IF P(Ebola) ≥ 0.5 THEN triage = Emergency (CF +0.95)"@en ;
    :salience 0 ;
    :usesPathology :Ebola ;
    dct:source :Src_who2014ebola .

:Rule_T-GBS a :TriageRule ;
    rdfs:label "Suspected Guillain-Barre syndrome needs same-day hospital assessment"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Urgent ] ;
    :certaintyFactor 0.8 ;
    :code "T-GBS" ;
    :mappingFidelity "faithful" ;
    :premise [ a :BeliefAtLeast ;
            :onPathology :GuillainBarreSyndrome ;
            :threshold 0.5 ] ;
    :ruleIndex 160 ;
    :ruleText "IF P(Guillain-Barré syndrome) ≥ 0.5 THEN triage = Urgent (CF +0.80)"@en ;
    :salience 0 ;
    :usesPathology :GuillainBarreSyndrome ;
    dct:source :Src_leonhard2019 .

:Rule_T-GIBLEED a :TriageRule ;
    rdfs:label "Gastrointestinal bleeding needs same-day assessment"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Urgent ] ;
    :certaintyFactor 0.8 ;
    :code "T-GIBLEED" ;
    :mappingFidelity "faithful" ;
    :premise [ a :ConceptHolds ;
            :onConcept :C_GastrointestinalBleeding ] ;
    :ruleIndex 162 ;
    :ruleText "IF Gastrointestinal bleeding (melaena, haematochezia, haematemesis) THEN triage = Urgent (CF +0.80)"@en ;
    :salience 0 ;
    :usesConcept :C_GastrointestinalBleeding ;
    dct:source :Src_stanley2019 .

:Rule_T-MG a :TriageRule ;
    rdfs:label "Myasthenia with dyspnoea or dysphagia: risk of crisis"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Urgent ] ;
    :certaintyFactor 0.8 ;
    :code "T-MG" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :BeliefAtLeast ;
                        :onPathology :MyastheniaGravis ;
                        :threshold 0.5 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :EvidencePresent ;
                                    :onEvidence :E_65 ] ) ] ) ] ;
    :ruleIndex 165 ;
    :ruleText "IF P(Myasthenia gravis) ≥ 0.5 AND (Experiencing shortness of breath or difficulty breathing in a significant way OR Difficulty swallowing, or have a feeling of discomfort/blockage when swallowing) THEN triage = Urgent (CF +0.80)"@en ;
    :salience 0 ;
    :usesEvidence :E_65,
        :E_66 ;
    :usesPathology :MyastheniaGravis ;
    dct:source :Src_gilhus2016 .

:Rule_T-PE a :TriageRule ;
    rdfs:label "Suspected pulmonary embolism is an emergency"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Emergency ] ;
    :certaintyFactor 0.9 ;
    :code "T-PE" ;
    :mappingFidelity "faithful" ;
    :premise [ a :BeliefAtLeast ;
            :onPathology :PulmonaryEmbolism ;
            :threshold 0.5 ] ;
    :ruleIndex 155 ;
    :ruleText "IF P(Pulmonary embolism) ≥ 0.5 THEN triage = Emergency (CF +0.90)"@en ;
    :salience 0 ;
    :usesPathology :PulmonaryEmbolism ;
    dct:source :Src_konstantinides2020 .

:Rule_T-PTX a :TriageRule ;
    rdfs:label "Suspected pneumothorax needs hospital assessment"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Urgent ] ;
    :certaintyFactor 0.8 ;
    :code "T-PTX" ;
    :mappingFidelity "faithful" ;
    :premise [ a :BeliefAtLeast ;
            :onPathology :SpontaneousPneumothorax ;
            :threshold 0.5 ] ;
    :ruleIndex 156 ;
    :ruleText "IF P(Spontaneous pneumothorax) ≥ 0.5 THEN triage = Urgent (CF +0.80)"@en ;
    :salience 0 ;
    :usesPathology :SpontaneousPneumothorax ;
    dct:source :Src_macduff2010 .

:Rule_T-SUDDEN-CHEST a :TriageRule ;
    rdfs:label "Sudden severe chest pain needs emergency assessment"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Emergency ] ;
    :certaintyFactor 0.8 ;
    :code "T-SUDDEN-CHEST" ;
    :mappingFidelity "faithful" ;
    :premise [ a :ConceptHolds ;
            :onConcept :C_SuddenSevereChestPain ] ;
    :ruleIndex 153 ;
    :ruleText "IF Severe chest pain of abrupt onset THEN triage = Emergency (CF +0.80)"@en ;
    :salience 0 ;
    :usesConcept :C_SuddenSevereChestPain ;
    dct:source :Src_gulati2021 .

:Rule_T-SYNCOPE a :TriageRule ;
    rdfs:label "Loss of consciousness needs same-day assessment"@en ;
    :asserts [ a :TriageConsequent ;
            :concludesTriage :Urgent ] ;
    :certaintyFactor 0.7 ;
    :code "T-SYNCOPE" ;
    :mappingFidelity "faithful" ;
    :premise [ a :EvidencePresent ;
            :onEvidence :E_159 ] ;
    :ruleIndex 161 ;
    :ruleText "IF Lose consciousness THEN triage = Urgent (CF +0.70)"@en ;
    :salience 0 ;
    :usesEvidence :E_159 ;
    dct:source :Src_brignole2018 .

:Rule_X-ALR-1 a :DiagnosticRule ;
    rdfs:label "Allergic rhinitis less likely with fever"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :AllergicSinusitis ] ;
    :certaintyFactor -0.3 ;
    :code "X-ALR-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_181 ] [ a :EvidencePresent ;
                        :onEvidence :E_91 ] ) ] ;
    :ruleIndex 141 ;
    :ruleText "IF Nasal congestion or a clear runny nose AND Fever (either felt or measured with a thermometer) THEN Allergic sinusitis (CF -0.30)"@en ;
    :salience 0 ;
    :usesEvidence :E_181,
        :E_91 ;
    dct:source :Src_bousquet2008 .

:Rule_X-PAN-1 a :DiagnosticRule ;
    rdfs:label "Panic attack less likely with cardiac red flags (not attributable to another condition)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PanicAttack ] ;
    :certaintyFactor -0.4 ;
    :code "X-PAN-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_DSM5PanicSymptoms ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_PainRadiatingToArmNeckJaw ] [ a :EvidencePresent ;
                                    :onEvidence :E_164 ] [ a :EvidencePresent ;
                                    :onEvidence :E_159 ] ) ] ) ] ;
    :ruleIndex 138 ;
    :ruleText "IF Four or more DSM-5 panic-attack symptoms AND (Pain radiating to the arm, shoulder, neck or jaw OR Heart is beating very irregularly or in a disorganized pattern OR Lose consciousness) THEN Panic attack (CF -0.40)"@en ;
    :salience 0 ;
    :usesConcept :C_DSM5PanicSymptoms,
        :C_PainRadiatingToArmNeckJaw ;
    :usesEvidence :E_159,
        :E_164 ;
    dct:source :Src_apa2013dsm5 ;
    rdfs:comment "DSM-5: the attack must not be attributable to another medical condition."@en .

