                                    :onEvidence :E_181 ] [ a :EvidencePresent ;
                                    :onEvidence :E_201 ] ) ] ) ] ;
    :ruleIndex 145 ;
    :ruleText "IF Ear pain (otalgia) AND (Fever (either felt or measured with a thermometer) OR Nasal congestion or a clear runny nose OR Cough) THEN Acute otitis media (CF +0.60)"@en ;
