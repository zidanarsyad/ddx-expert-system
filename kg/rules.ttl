:Rule_D-HER-1 a :DiagnosticRule ;
    rdfs:label "Inguinal hernia: groin pain or bulge increased by coughing or straining"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :InguinalHernia ] ;
    :certaintyFactor 0.8 ;
    :code "D-HER-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_GroinPainOrBulge ] [ a :EvidencePresent ;
                        :onEvidence :E_221 ] ) ] ;
    :ruleIndex 149 ;
    :ruleText "IF Groin pain, swelling or lesion AND Are the symptoms or pain increased with coughing, with an effort like lifting a weight or from forcing a bowel movement THEN Inguinal hernia (CF +0.80)"@en ;
    :salience 0 ;
    :usesConcept :C_GroinPainOrBulge ;
    :usesEvidence :E_221 ;
    dct:source :Src_herniasurge2018 .

:Rule_D-HIV-1 a :DiagnosticRule ;
    rdfs:label "Acute HIV: exposure risk with fever and rash, adenopathy, sore throat, myalgia or mucosal lesions"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :HIVInitialInfection ] ;
    :certaintyFactor 0.7 ;
    :code "D-HIV-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_HIVExposureRisk ] [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_129 ] [ a :EvidencePresent ;
                                    :onEvidence :E_9 ] [ a :ConceptHolds ;
                                    :onConcept :C_SoreThroat ] [ a :EvidencePresent ;
                                    :onEvidence :E_144 ] [ a :ConceptHolds ;
                                    :onConcept :C_MucocutaneousUlcers ] ) ] ) ] ;
    :ruleIndex 122 ;
    :ruleText "IF Recent HIV exposure risk AND Fever (either felt or measured with a thermometer) AND (Lesions, redness or problems on your skin that you believe are related to the condition you are consulting for OR Swollen or painful lymph nodes OR Sore throat OR Diffuse (widespread) muscle pain OR Lesions of the oral or genital mucosa) THEN HIV (initial infection) (CF +0.70)"@en ;
    :salience 0 ;
    :usesConcept :C_HIVExposureRisk,
        :C_MucocutaneousUlcers,
        :C_SoreThroat ;
    :usesEvidence :E_129,
        :E_144,
        :E_9,
        :E_91 ;
    dct:source :Src_hecht2002 .

:Rule_D-HIV-2 a :DiagnosticRule ;
    rdfs:label "Acute HIV: fever with mucocutaneous lesions"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :HIVInitialInfection ] ;
    :certaintyFactor 0.3 ;
    :code "D-HIV-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :ConceptHolds ;
                        :onConcept :C_MucocutaneousUlcers ] ) ] ;
    :ruleIndex 123 ;
    :ruleText "IF Fever (either felt or measured with a thermometer) AND Lesions of the oral or genital mucosa THEN HIV (initial infection) (CF +0.30)"@en ;
    :salience 0 ;
    :usesConcept :C_MucocutaneousUlcers ;
    :usesEvidence :E_91 ;
    dct:source :Src_hecht2002 .

:Rule_D-LAR-1 a :DiagnosticRule ;
    rdfs:label "Acute laryngitis: hoarseness after a cold or with cough, no stridor"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :AcuteLaryngitis ] ;
    :certaintyFactor 0.6 ;
    :code "D-LAR-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_212 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_116 ] [ a :EvidencePresent ;
                                    :onEvidence :E_201 ] [ a :ConceptHolds ;
                                    :onConcept :C_SoreThroat ] ) ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_194 ] ] ) ] ;
    :ruleIndex 90 ;
    :ruleText "IF Tone of your voice has become deeper, softer or hoarse AND (Cold in the last 2 weeks OR Cough OR Sore throat) AND NOT High pitched sound when breathing in THEN Acute laryngitis (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_SoreThroat ;
    :usesEvidence :E_116,
        :E_194,
        :E_201,
        :E_212 ;
    dct:source :Src_wood2014 .

:Rule_D-LCA-1 a :DiagnosticRule ;
    rdfs:label "Lung cancer: age >= 40 with unexplained haemoptysis (NICE NG12 1.1.1)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PulmonaryNeoplasm ] ;
    :certaintyFactor 0.5 ;
    :code "D-LCA-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :AgeComparison ;
                        :comparator "ge" ;
                        :threshold 40.0 ] [ a :EvidencePresent ;
                        :onEvidence :E_45 ] ) ] ;
    :ruleIndex 110 ;
    :ruleText "IF age ≥ 40 AND Coughing up blood THEN Pulmonary neoplasm (CF +0.50)"@en ;
    :salience 0 ;
    :usesEvidence :E_45 ;
    dct:source :Src_nice2015ng12 .

:Rule_D-LCA-2 a :DiagnosticRule ;
    rdfs:label "Lung cancer: age >= 40 with NICE symptoms (NICE NG12 1.1.2)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PulmonaryNeoplasm ] ;
    :certaintyFactor 0.2 ;
    :code "D-LCA-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :AgeComparison ;
                        :comparator "ge" ;
                        :threshold 40.0 ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_NICELungTwoSymptoms ] [ a :AllOf ;
                                    :operands ( [ a :ConceptHolds ;
                                                :onConcept :C_EverSmoked ] [ a :ConceptHolds ;
                                                :onConcept :C_NICELungOneSymptom ] ) ] ) ] ) ] ;
    :ruleIndex 111 ;
    :ruleText "IF age ≥ 40 AND (Two or more NICE lung-cancer symptoms OR (Current or former smoker AND One or more NICE lung-cancer symptoms)) THEN Pulmonary neoplasm (CF +0.20)"@en ;
    :salience 0 ;
    :usesConcept :C_EverSmoked,
        :C_NICELungOneSymptom,
        :C_NICELungTwoSymptoms ;
    dct:source :Src_nice2015ng12 .

:Rule_D-LSP-1 a :DiagnosticRule ;
    rdfs:label "Laryngospasm: episodic stridor in a patient with reflux, no fever"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Larygospasm ] ;
    :certaintyFactor 0.5 ;
    :code "D-LSP-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_194 ] [ a :EvidencePresent ;
                        :onEvidence :E_125 ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_91 ] ] ) ] ;
    :ruleIndex 95 ;
    :ruleText "IF High pitched sound when breathing in AND Gastroesophageal reflux AND NOT Fever (either felt or measured with a thermometer) THEN Larygospasm (CF +0.50)"@en ;
    :salience 0 ;
    :usesEvidence :E_125,
        :E_194,
        :E_91 ;
    dct:source :Src_loughlin1996 .

:Rule_D-MG-1 a :DiagnosticRule ;
    rdfs:label "Myasthenia gravis: fatigable ocular or bulbar weakness"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :MyastheniaGravis ] ;
    :certaintyFactor 0.8 ;
    :code "D-MG-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_OcularOrBulbarWeakness ] [ a :EvidencePresent ;
                        :onEvidence :E_90 ] ) ] ;
    :ruleIndex 129 ;
    :ruleText "IF Ocular or bulbar weakness (ptosis, diplopia, dysphagia, dysarthria) AND Symptoms of muscle weakness increase with fatigue and/or stress THEN Myasthenia gravis (CF +0.80)"@en ;
    :salience 0 ;
    :usesConcept :C_OcularOrBulbarWeakness ;
    :usesEvidence :E_90 ;
    dct:source :Src_gilhus2016 .

:Rule_D-MG-2 a :DiagnosticRule ;
    rdfs:label "Myasthenia gravis: ptosis with diplopia"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :MyastheniaGravis ] ;
    :certaintyFactor 0.4 ;
    :code "D-MG-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_172 ] [ a :EvidencePresent ;
                        :onEvidence :E_52 ] ) ] ;
    :ruleIndex 130 ;
    :ruleText "IF Hard time opening/raising one or both eyelids AND Perception of seeing two images of a single object seen overlapping or adjacent to each other (double vision) THEN Myasthenia gravis (CF +0.40)"@en ;
    :salience 0 ;
    :usesEvidence :E_172,
        :E_52 ;
    dct:source :Src_gilhus2016 .

:Rule_D-MYO-1 a :DiagnosticRule ;
    rdfs:label "Myocarditis: chest pain with palpitations or dyspnoea after a viral infection"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Myocarditis ] ;
    :certaintyFactor 0.6 ;
    :code "D-MYO-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_0 ] [ a :ConceptHolds ;
                        :onConcept :C_ChestPain ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_155 ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :EvidencePresent ;
                                    :onEvidence :E_64 ] ) ] ) ] ;
    :ruleIndex 73 ;
    :ruleText "IF Viral infection AND Chest pain AND (Heart is beating fast (racing), irregularly (missing a beat) or do you feel palpitations OR Experiencing shortness of breath or difficulty breathing in a significant way OR Out of breath with minimal physical effort) THEN Myocarditis (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_ChestPain ;
    :usesEvidence :E_0,
        :E_155,
        :E_64,
        :E_66 ;
    dct:source :Src_caforio2013 .

:Rule_D-PAN-1 a :DiagnosticRule ;
    rdfs:label "Panic attack: four or more DSM-5 symptoms"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PanicAttack ] ;
    :certaintyFactor 0.6 ;
    :code "D-PAN-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :ConceptHolds ;
            :onConcept :C_DSM5PanicSymptoms ] ;
    :ruleIndex 136 ;
    :ruleText "IF Four or more DSM-5 panic-attack symptoms THEN Panic attack (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_DSM5PanicSymptoms ;
    dct:source :Src_apa2013dsm5 .

:Rule_D-PAN-2 a :DiagnosticRule ;
    rdfs:label "Panic attack: DSM-5 symptoms with anxiety, depression or psychiatric family history"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PanicAttack ] ;
    :certaintyFactor 0.2 ;
    :code "D-PAN-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_DSM5PanicSymptoms ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_81 ] [ a :EvidencePresent ;
                                    :onEvidence :E_80 ] [ a :EvidencePresent ;
                                    :onEvidence :E_16 ] [ a :EvidencePresent ;
                                    :onEvidence :E_29 ] ) ] ) ] ;
    :ruleIndex 137 ;
    :ruleText "IF Four or more DSM-5 panic-attack symptoms AND (Chronic anxiety OR Depression OR Anxious OR Do any members of your immediate family have a psychiatric illness) THEN Panic attack (CF +0.20)"@en ;
    :salience 0 ;
    :usesConcept :C_DSM5PanicSymptoms ;
    :usesEvidence :E_16,
        :E_29,
        :E_80,
        :E_81 ;
    dct:source :Src_apa2013dsm5 .

:Rule_D-PCA-1 a :DiagnosticRule ;
    rdfs:label "Pancreatic cancer: age >= 40 with jaundice (NICE NG12 1.2.4)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PancreaticNeoplasm ] ;
    :certaintyFactor 0.6 ;
    :code "D-PCA-1" ;
    :mappingFidelity "proxy" ;
    :premise [ a :AllOf ;
            :operands ( [ a :AgeComparison ;
                        :comparator "ge" ;
                        :threshold 40.0 ] [ a :ConceptHolds ;
                        :onConcept :C_JaundiceFeatures ] ) ] ;
    :ruleIndex 112 ;
    :ruleText "IF age ≥ 40 AND Features of jaundice (pale stools, dark urine, yellow skin) THEN Pancreatic neoplasm (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_JaundiceFeatures ;
    dct:source :Src_nice2015ng12 .

:Rule_D-PCA-2 a :DiagnosticRule ;
    rdfs:label "Pancreatic cancer: age >= 60 with weight loss and abdominal or back pain, diarrhoea, nausea or diabetes (NICE NG12 1.2.5)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PancreaticNeoplasm ] ;
    :certaintyFactor 0.4 ;
    :code "D-PCA-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :AgeComparison ;
                        :comparator "ge" ;
                        :threshold 60.0 ] [ a :EvidencePresent ;
                        :onEvidence :E_162 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_51 ] [ a :ConceptHolds ;
                                    :onConcept :C_AbdominalPain ] [ a :AnswerIn ;
                                    :inValueSet :VS_BACK ;
                                    :onEvidence :E_57 ] [ a :EvidencePresent ;
                                    :onEvidence :E_148 ] [ a :EvidencePresent ;
                                    :onEvidence :E_69 ] ) ] ) ] ;
    :ruleIndex 113 ;
    :ruleText "IF age ≥ 60 AND Involuntary weight loss over the last 3 months AND (Diarrhea or an increase in stool frequency OR Abdominal pain OR Does the pain radiate to another location ∈ {Back} OR Feeling nauseous or do you feel like vomiting OR Diabetes) THEN Pancreatic neoplasm (CF +0.40)"@en ;
    :salience 0 ;
    :usesConcept :C_AbdominalPain ;
    :usesEvidence :E_148,
        :E_162,
        :E_51,
        :E_57,
        :E_69 ;
    dct:source :Src_nice2015ng12 .

:Rule_D-PE-1 a :DiagnosticRule ;
    rdfs:label "Pulmonary embolism likely: Wells score > 4 with dyspnoea, pleuritic pain or haemoptysis"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PulmonaryEmbolism ] ;
    :certaintyFactor 0.7 ;
    :code "D-PE-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ScoreComparison ;
                        :comparator "gt" ;
                        :onScore :Score_WellsPE ;
                        :threshold 4.0 ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_PleuriticChestPain ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :EvidencePresent ;
                                    :onEvidence :E_45 ] ) ] ) ] ;
    :ruleIndex 74 ;
    :ruleText "IF Wells score for pulmonary embolism > 4 AND (Pleuritic chest pain (worse on deep breathing) OR Experiencing shortness of breath or difficulty breathing in a significant way OR Coughing up blood) THEN Pulmonary embolism (CF +0.70)"@en ;
    :salience 0 ;
    :usesConcept :C_PleuriticChestPain ;
    :usesEvidence :E_45,
        :E_66 ;
    :usesScore :Score_WellsPE ;
    dct:source :Src_wells2000 ;
    rdfs:comment "Two-tier Wells: PE likely if > 4 points. Heart rate > 100 (+1.5) and 'PE the most likely diagnosis' (+3) cannot be scored, so the score is a lower bound."@en .

:Rule_D-PE-2 a :DiagnosticRule ;
    rdfs:label "Pulmonary embolism possible: Wells score 2-4 with dyspnoea or pleuritic pain"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PulmonaryEmbolism ] ;
    :certaintyFactor 0.4 ;
    :code "D-PE-2" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ScoreComparison ;
                        :comparator "ge" ;
                        :onScore :Score_WellsPE ;
                        :threshold 2.0 ] [ a :ScoreComparison ;
                        :comparator "le" ;
                        :onScore :Score_WellsPE ;
                        :threshold 4.0 ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_PleuriticChestPain ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] ) ] ) ] ;
    :ruleIndex 75 ;
    :ruleText "IF Wells score for pulmonary embolism ≥ 2 AND Wells score for pulmonary embolism ≤ 4 AND (Pleuritic chest pain (worse on deep breathing) OR Experiencing shortness of breath or difficulty breathing in a significant way) THEN Pulmonary embolism (CF +0.40)"@en ;
    :salience 0 ;
    :usesConcept :C_PleuriticChestPain ;
    :usesEvidence :E_66 ;
    :usesScore :Score_WellsPE ;
    dct:source :Src_wells2000 .

:Rule_D-PE-3 a :DiagnosticRule ;
    rdfs:label "Pulmonary embolism: hormone use as a predisposing factor"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :PulmonaryEmbolism ] ;
    :certaintyFactor 0.2 ;
    :code "D-PE-3" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_100 ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_PleuriticChestPain ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] ) ] ) ] ;
    :ruleIndex 76 ;
    :ruleText "IF Take hormones AND (Pleuritic chest pain (worse on deep breathing) OR Experiencing shortness of breath or difficulty breathing in a significant way) THEN Pulmonary embolism (CF +0.20)"@en ;
    :salience 0 ;
    :usesConcept :C_PleuriticChestPain ;
    :usesEvidence :E_100,
        :E_66 ;
    dct:source :Src_konstantinides2020 .

:Rule_D-PER-1 a :DiagnosticRule ;
    rdfs:label "Pericarditis: pleuritic chest pain relieved by sitting up (ESC 2015)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Pericarditis ] ;
    :certaintyFactor 0.7 ;
    :code "D-PER-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_PleuriticChestPain ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_217 ] [ a :EvidencePresent ;
                                    :onEvidence :E_33 ] ) ] ) ] ;
    :ruleIndex 71 ;
    :ruleText "IF Pleuritic chest pain (worse on deep breathing) AND (Symptoms worse when lying down and alleviated while sitting up OR Pain that improves when you lean forward) THEN Pericarditis (CF +0.70)"@en ;
    :salience 0 ;
    :usesConcept :C_PleuriticChestPain ;
    :usesEvidence :E_217,
        :E_33 ;
    dct:source :Src_adler2015 ;
    rdfs:comment "ESC: typical pain is sharp, pleuritic, improved by sitting up and leaning forward; rub, ECG and effusion criteria need examination."@en .

:Rule_D-PER-2 a :DiagnosticRule ;
    rdfs:label "Pericarditis: chest pain after a viral infection or previous pericarditis"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Pericarditis ] ;
    :certaintyFactor 0.3 ;
    :code "D-PER-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_ChestPain ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_0 ] [ a :EvidencePresent ;
                                    :onEvidence :E_3 ] ) ] ) ] ;
    :ruleIndex 72 ;
    :ruleText "IF Chest pain AND (Viral infection OR Pericarditis) THEN Pericarditis (CF +0.30)"@en ;
    :salience 0 ;
    :usesConcept :C_ChestPain ;
    :usesEvidence :E_0,
        :E_3 ;
    dct:source :Src_adler2015 .

:Rule_D-PERT-1 a :DiagnosticRule ;
    rdfs:label "Pertussis: paroxysms, whoop or post-tussive vomiting (CDC clinical criteria)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :WhoopingCough ] ;
    :certaintyFactor 0.5 ;
    :code "D-PERT-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :ConceptHolds ;
            :onConcept :C_PertussisClinicalSigns ] ;
    :ruleIndex 97 ;
    :ruleText "IF Paroxysmal cough, inspiratory whoop or post-tussive vomiting THEN Whooping cough (CF +0.50)"@en ;
    :salience 0 ;
    :usesConcept :C_PertussisClinicalSigns ;
    dct:source :Src_cdc2020pertussis ;
    rdfs:comment "The CDC clinical criteria also require a cough of >= 2 weeks; duration is not asked."@en .

:Rule_D-PERT-2 a :DiagnosticRule ;
    rdfs:label "Pertussis: clinical signs with contact with a pertussis case (CDC probable case)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :WhoopingCough ] ;
    :certaintyFactor 0.8 ;
    :code "D-PERT-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_PertussisClinicalSigns ] [ a :EvidencePresent ;
                        :onEvidence :E_40 ] ) ] ;
    :ruleIndex 98 ;
    :ruleText "IF Paroxysmal cough, inspiratory whoop or post-tussive vomiting AND In contact with someone who has had pertussis (whoooping cough) THEN Whooping cough (CF +0.80)"@en ;
    :salience 0 ;
    :usesConcept :C_PertussisClinicalSigns ;
    :usesEvidence :E_40 ;
    dct:source :Src_cdc2020pertussis .

:Rule_D-PNA-1 a :DiagnosticRule ;
    rdfs:label "Pneumonia: cough and fever with dyspnoea or pleuritic pain"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Pneumonia ] ;
    :certaintyFactor 0.5 ;
    :code "D-PNA-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_201 ] [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :ConceptHolds ;
                                    :onConcept :C_PleuriticChestPain ] ) ] ) ] ;
    :ruleIndex 100 ;
    :ruleText "IF Cough AND Fever (either felt or measured with a thermometer) AND (Experiencing shortness of breath or difficulty breathing in a significant way OR Pleuritic chest pain (worse on deep breathing)) THEN Pneumonia (CF +0.50)"@en ;
    :salience 0 ;
    :usesConcept :C_PleuriticChestPain ;
    :usesEvidence :E_201,
        :E_66,
        :E_91 ;
    dct:source :Src_metlay2019 .

:Rule_D-PNA-2 a :DiagnosticRule ;
    rdfs:label "Pneumonia: purulent sputum or chills with fever"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Pneumonia ] ;
    :certaintyFactor 0.2 ;
    :code "D-PNA-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_77 ] [ a :EvidencePresent ;
                                    :onEvidence :E_94 ] ) ] [ a :EvidencePresent ;
                        :onEvidence :E_201 ] ) ] ;
    :ruleIndex 101 ;
    :ruleText "IF Fever (either felt or measured with a thermometer) AND (Cough that produces colored or more abundant sputum than usual OR Chills or shivers) AND Cough THEN Pneumonia (CF +0.20)"@en ;
    :salience 0 ;
    :usesEvidence :E_201,
        :E_77,
        :E_91,
        :E_94 ;
    dct:source :Src_metlay2019 .

:Rule_D-PTX-1 a :DiagnosticRule ;
    rdfs:label "Spontaneous pneumothorax: pleuritic pain and dyspnoea with a risk factor (BTS 2010)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :SpontaneousPneumothorax ] ;
    :certaintyFactor 0.5 ;
    :code "D-PTX-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_PleuriticChestPain ] [ a :EvidencePresent ;
                        :onEvidence :E_66 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_21 ] [ a :EvidencePresent ;
                                    :onEvidence :E_165 ] [ a :ConceptHolds ;
                                    :onConcept :C_EverSmoked ] [ a :EvidencePresent ;
                                    :onEvidence :E_123 ] ) ] ) ] ;
    :ruleIndex 77 ;
    :ruleText "IF Pleuritic chest pain (worse on deep breathing) AND Experiencing shortness of breath or difficulty breathing in a significant way AND (Spontaneous pneumothorax OR Have any of your family members ever had a pneumothorax OR Current or former smoker OR Chronic obstructive pulmonary disease (COPD)) THEN Spontaneous pneumothorax (CF +0.50)"@en ;
    :salience 0 ;
    :usesConcept :C_EverSmoked,
        :C_PleuriticChestPain ;
    :usesEvidence :E_123,
        :E_165,
        :E_21,
        :E_66 ;
    dct:source :Src_macduff2010 .

:Rule_D-PTX-2 a :DiagnosticRule ;
    rdfs:label "Spontaneous pneumothorax: sudden severe chest pain with dyspnoea"@en ;
