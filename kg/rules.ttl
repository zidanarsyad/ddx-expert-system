:Rule_D-CLU-1 a :DiagnosticRule ;
    rdfs:label "Cluster headache: severe orbital/temporal pain with an autonomic sign (ICHD-3)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :ClusterHeadache ] ;
    :certaintyFactor 0.8 ;
    :code "D-CLU-1" ;
    :mappingFidelity "partial" ;
