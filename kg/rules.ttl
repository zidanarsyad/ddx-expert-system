    :ruleIndex 104 ;
    :ruleText "IF Known asthma AND Wheezing sound when you exhale AND Experiencing shortness of breath or difficulty breathing in a significant way THEN Bronchospasm / acute asthma exacerbation (CF +0.70)"@en ;
    :salience 0 ;
