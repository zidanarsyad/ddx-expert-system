    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_ChestPain ] [ a :ConceptHolds ;
                        :onConcept :C_CardiovascularRiskProfile ] ) ] ;
    :ruleIndex 70 ;
    :ruleText "IF Chest pain AND Two or more cardiovascular risk factors THEN Possible NSTEMI / STEMI (CF +0.30) AND Stable angina (CF +0.30) AND Unstable angina (CF +0.30)"@en ;
    :salience 0 ;
    :usesConcept :C_CardiovascularRiskProfile,
        :C_ChestPain ;
    dct:source :Src_gulati2021 .

:Rule_D-ADR-1 a :DiagnosticRule ;
    rdfs:label "Acute dystonic reaction: dystonic signs after a neuroleptic"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :AcuteDystonicReactions ] ;
    :certaintyFactor 0.9 ;
    :code "D-ADR-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_RecentNeurolepticExposure ] [ a :ConceptHolds ;
                        :onConcept :C_AcuteDystonicSigns ] ) ] ;
    :ruleIndex 134 ;
    :ruleText "IF Recent antipsychotic or parenteral sedative/antiemetic AND Acute dystonic signs (spasms, torticollis, trismus, tongue protrusion, oculogyric crisis) THEN Acute dystonic reactions (CF +0.90)"@en ;
    :salience 0 ;
    :usesConcept :C_AcuteDystonicSigns,
        :C_RecentNeurolepticExposure ;
    dct:source :Src_vanharten1999 .

:Rule_D-ADR-2 a :DiagnosticRule ;
    rdfs:label "Acute dystonic reaction: two or more dystonic signs"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :AcuteDystonicReactions ] ;
    :certaintyFactor 0.4 ;
    :code "D-ADR-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AtLeast ;
            :minCount 2 ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_193 ] [ a :EvidencePresent ;
                        :onEvidence :E_192 ] [ a :EvidencePresent ;
                        :onEvidence :E_205 ] [ a :EvidencePresent ;
                        :onEvidence :E_168 ] [ a :EvidencePresent ;
                        :onEvidence :E_180 ] [ a :EvidencePresent ;
                        :onEvidence :E_128 ] ) ] ;
    :ruleIndex 135 ;
    :ruleText "IF at least 2 of [Annoying muscle spasms in your face, neck or any other part of your body; Muscle spasms or soreness in your neck are keeping you from turning your head to one side; Suddenly have difficulty or an inability to open your mouth or have jaw pain when opening it; Trouble keeping your tongue in your mouth; Unable to control the direction of your eyes; Felt like you were suffocating for a very short time associated with inability to breathe or speak] THEN Acute dystonic reactions (CF +0.40)"@en ;
    :salience 0 ;
    :usesEvidence :E_128,
        :E_168,
        :E_180,
        :E_192,
        :E_193,
        :E_205 ;
    dct:source :Src_vanharten1999 .

:Rule_D-AF-1 a :DiagnosticRule ;
