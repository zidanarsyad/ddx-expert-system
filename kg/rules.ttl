            :threshold 0.5 ] ;
    :ruleIndex 186 ;
    :ruleText "IF P(Acute dystonic reactions) ≥ 0.5 THEN recommend: Parenteral anticholinergic (e.g. biperiden or benztropine) and review of the causative drug (CF +1.00)"@en ;
    :salience 0 ;
    :usesPathology :AcuteDystonicReactions ;
    dct:source :Src_vanharten1999 .

:Rule_R-ANA a :RecommendationRule ;
