    :usesEvidence :E_73,
        :E_91 ;
    dct:source :Src_who2014ebola .

:Rule_D-EBO-2 a :DiagnosticRule ;
    rdfs:label "Ebola suspected case: fever and >= 3 listed symptoms after travel to an affected area (WHO 2014)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Ebola ] ;
    :certaintyFactor 0.7 ;
    :code "D-EBO-2" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_91 ] [ a :ConceptHolds ;
                        :onConcept :C_TravelToWestAfrica ] [ a :AtLeast ;
                        :minCount 3 ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_148 ] [ a :EvidencePresent ;
                                    :onEvidence :E_51 ] [ a :AnyOf ;
                                    :operands ( [ a :EvidencePresent ;
                                                :onEvidence :E_32 ] [ a :EvidencePresent ;
                                                :onEvidence :E_161 ] [ a :EvidencePresent ;
                                                :onEvidence :E_174 ] ) ] [ a :AnyOf ;
                                    :operands ( [ a :EvidencePresent ;
                                                :onEvidence :E_88 ] [ a :EvidencePresent ;
                                                :onEvidence :E_89 ] ) ] [ a :ConceptHolds ;
                                    :onConcept :C_AbdominalPain ] [ a :EvidencePresent ;
                                    :onEvidence :E_144 ] [ a :EvidencePresent ;
                                    :onEvidence :E_65 ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :ConceptHolds ;
                                    :onConcept :C_Headache ] ) ] ) ] ;
    :ruleIndex 125 ;
    :ruleText "IF Fever (either felt or measured with a thermometer) AND Travel to West Africa in the last 4 weeks AND at least 3 of [Feeling nauseous or do you feel like vomiting; Diarrhea or an increase in stool frequency; Decrease in appetite OR Loss of appetite or do you get full more quickly then usually OR Unintentionally losing weight or have you lost your appetite; So tired that you are unable to do your usual activities or are you stuck in your bed all day long OR Constantly feel fatigued or do you have non-restful sleep; Abdominal pain; Diffuse (widespread) muscle pain; Difficulty swallowing, or have a feeling of discomfort/blockage when swallowing; Experiencing shortness of breath or difficulty breathing in a significant way; Headache] THEN Ebola (CF +0.70)"@en ;
    :salience 0 ;
    :usesConcept :C_AbdominalPain,
        :C_Headache,
        :C_TravelToWestAfrica ;
    :usesEvidence :E_144,
        :E_148,
        :E_161,
        :E_174,
        :E_32,
        :E_51,
        :E_65,
        :E_66,
        :E_88,
        :E_89,
        :E_91 ;
    dct:source :Src_who2014ebola ;
    rdfs:comment "WHO lists headache, vomiting, anorexia, diarrhoea, lethargy, stomach pain, aching muscles or joints, difficulty swallowing, breathing difficulty and hiccup; hiccup is not asked."@en .

:Rule_D-EBO-3 a :DiagnosticRule ;
