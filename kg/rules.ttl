:Src_centor1981 a :ClinicalDecisionRule ;
    :citationKey "centor1981" ;
    dct:bibliographicCitation "Centor RM, Witherspoon JM, Dalton HP, Brody CE, Link K (1981). The diagnosis of strep throat in adults in the emergency room. Medical Decision Making 1(3):239-246." ;
    bibo:doi "10.1177/0272989X8100100304" ;
    rdfs:seeAlso <https://doi.org/10.1177/0272989X8100100304> .

