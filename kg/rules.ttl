    dct:source :Src_brugada2020 .

:Rule_D-TB-1 a :DiagnosticRule ;
    rdfs:label "Tuberculosis: cough with haemoptysis or weight loss and fever or sweats (WHO symptom screen)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Tuberculosis ] ;
    :certaintyFactor 0.5 ;
    :code "D-TB-1" ;
