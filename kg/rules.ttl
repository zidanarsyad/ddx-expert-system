:REC_ADRENALINE a :Recommendation ;
    rdfs:label "Give intramuscular adrenaline 0.01 mg/kg (max 0.5 mg adult) into the mid-anterolateral thigh and call emergency services"@en ;
    :code "REC_ADRENALINE" ;
    dct:source :Src_cardona2020 .

:REC_ANA a :Recommendation ;
    rdfs:label "Antinuclear antibody test (entry criterion ANA >= 1:80)"@en ;
    :code "REC_ANA" ;
    dct:source :Src_aringer2019 .

:REC_ANTICHOLINERGIC a :Recommendation ;
    rdfs:label "Parenteral anticholinergic (e.g. biperiden or benztropine) and review of the causative drug"@en ;
    :code "REC_ANTICHOLINERGIC" ;
    dct:source :Src_vanharten1999 .

:REC_ASTHMA a :Recommendation ;
    rdfs:label "Inhaled reliever (SABA or ICS-formoterol) and assessment of exacerbation severity"@en ;
    :code "REC_ASTHMA" ;
    dct:source :Src_reddel2022 .

:REC_CBC a :Recommendation ;
    rdfs:label "Full blood count; anaemia if haemoglobin < 130 g/L in men or < 120 g/L in non-pregnant women"@en ;
    :code "REC_CBC" ;
    dct:source :Src_who2011hb .

:REC_CHAGAS a :Recommendation ;
    rdfs:label "Blood smear (acute phase) or serology (chronic phase) for Trypanosoma cruzi"@en ;
    :code "REC_CHAGAS" ;
    dct:source :Src_rassi2010 .

:REC_COPD a :Recommendation ;
    rdfs:label "Short-acting bronchodilators; consider antibiotics when sputum purulence has increased"@en ;
    :code "REC_COPD" ;
    dct:source :Src_agusti2023 .

:REC_CTPA a :Recommendation ;
    rdfs:label "CT pulmonary angiography (PE likely by the Wells score)"@en ;
    :code "REC_CTPA" ;
    dct:source :Src_konstantinides2020 .

:REC_CXR_PNEUMONIA a :Recommendation ;
    rdfs:label "Chest X-ray to confirm pneumonia and CRB-65 severity assessment"@en ;
    :code "REC_CXR_PNEUMONIA" ;
    dct:source :Src_metlay2019 .

:REC_DDIMER a :Recommendation ;
    rdfs:label "D-dimer test; a normal result excludes PE when PE is unlikely by the Wells score"@en ;
    :code "REC_DDIMER" ;
    dct:source :Src_konstantinides2020 .

:REC_ECG_TROPONIN a :Recommendation ;
    rdfs:label "12-lead ECG within 10 minutes of first medical contact and high-sensitivity troponin"@en ;
    :code "REC_ECG_TROPONIN" ;
    dct:source :Src_byrne2023 .

:REC_EXCLUDE_CARDIAC a :Recommendation ;
    rdfs:label "Exclude a cardiac or respiratory cause (ECG) before attributing symptoms to panic"@en ;
    :code "REC_EXCLUDE_CARDIAC" ;
    dct:source :Src_apa2013dsm5 .

:REC_FLU a :Recommendation ;
    rdfs:label "Antiviral treatment as early as possible for high-risk or hospitalised patients; otherwise symptomatic care"@en ;
    :code "REC_FLU" ;
    dct:source :Src_uyeki2019 .

:REC_HERNIA a :Recommendation ;
    rdfs:label "Surgical referral; urgent if the hernia is painful and irreducible"@en ;
    :code "REC_HERNIA" ;
    dct:source :Src_herniasurge2018 .

:REC_HIV_TEST a :Recommendation ;
    rdfs:label "HIV-1/2 antigen/antibody immunoassay, with HIV-1 RNA test when acute infection is suspected"@en ;
    :code "REC_HIV_TEST" ;
    dct:source :Src_cdc2014hiv .

:REC_ISOLATE_EBOLA a :Recommendation ;
    rdfs:label "Isolate the patient, use full personal protective equipment and notify public-health authorities"@en ;
    :code "REC_ISOLATE_EBOLA" ;
    dct:source :Src_who2014ebola .

:REC_LUNG_CANCER_PATHWAY a :Recommendation ;
    rdfs:label "Suspected-cancer pathway referral for lung cancer (age >= 40 with unexplained haemoptysis)"@en ;
    :code "REC_LUNG_CANCER_PATHWAY" ;
    dct:source :Src_nice2015ng12 .

:REC_NO_ANTIBIOTIC_THROAT a :Recommendation ;
    rdfs:label "Symptomatic care; no group A streptococcus testing or antibiotics when clear viral features are present"@en ;
    :code "REC_NO_ANTIBIOTIC_THROAT" ;
    dct:source :Src_shulman2012 .

:REC_OTOSCOPY a :Recommendation ;
    rdfs:label "Otoscopy to confirm a bulging tympanic membrane; analgesia, then antibiotics or observation"@en ;
    :code "REC_OTOSCOPY" ;
    dct:source :Src_lieberthal2013 .

:REC_PANCREAS_REFERRAL a :Recommendation ;
    rdfs:label "Suspected-cancer pathway referral for pancreatic cancer (age >= 40 with jaundice)"@en ;
    :code "REC_PANCREAS_REFERRAL" ;
    dct:source :Src_nice2015ng12 .

:REC_PERTUSSIS a :Recommendation ;
    rdfs:label "Nasopharyngeal PCR or culture for Bordetella pertussis; report to public health"@en ;
    :code "REC_PERTUSSIS" ;
    dct:source :Src_cdc2020pertussis .

:REC_PPI a :Recommendation ;
    rdfs:label "Empirical 8-week proton-pump-inhibitor trial if there are no alarm features"@en ;
    :code "REC_PPI" ;
    dct:source :Src_katz2022 .

:REC_SELF_CARE_COLD a :Recommendation ;
    rdfs:label "Symptomatic self-care; antibiotics are not indicated for the common cold"@en ;
    :code "REC_SELF_CARE_COLD" ;
    dct:source :Src_heikkinen2003 .

:REC_TB a :Recommendation ;
    rdfs:label "Chest X-ray and sputum test for tuberculosis; airborne precautions"@en ;
    :code "REC_TB" ;
    dct:source :Src_who2021tb .

:REC_URGENT_CT_PANCREAS a :Recommendation ;
    rdfs:label "Urgent direct-access CT scan to assess for pancreatic cancer"@en ;
    :code "REC_URGENT_CT_PANCREAS" ;
    dct:source :Src_nice2015ng12 .

:REC_URGENT_CXR a :Recommendation ;
    rdfs:label "Urgent direct-access chest X-ray to assess for lung cancer"@en ;
    :code "REC_URGENT_CXR" ;
    dct:source :Src_nice2015ng12 .

:Rule_A-ABDO a :AbstractionRule ;
    rdfs:label "Abdominal pain"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_AbdominalPain ] ;
    :certaintyFactor 1.0 ;
    :code "A-ABDO" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_53 ] [ a :AnswerIn ;
                        :inValueSet :VS_ABDOMEN ;
                        :onEvidence :E_55 ] ) ] ;
    :ruleIndex 12 ;
    :ruleText "IF Pain somewhere, related to your reason for consulting AND Pain somewhere ∈ {Abdomen} THEN Abdominal pain"@en ;
    :salience 0 ;
    :usesEvidence :E_53,
        :E_55 ;
    dct:source :Src_ddxplus2022 .

:Rule_A-ABRUPT a :AbstractionRule ;
    rdfs:label "Abrupt onset of pain"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_AbruptOnsetPain ] ;
    :certaintyFactor 1.0 ;
    :code "A-ABRUPT" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_53 ] [ a :ScaleComparison ;
                        :comparator "ge" ;
                        :onEvidence :E_59 ;
                        :threshold 7.0 ] ) ] ;
    :ruleIndex 4 ;
    :ruleText "IF Pain somewhere, related to your reason for consulting AND How fast did the pain appear ≥ 7/10 THEN Pain of abrupt onset (onset speed >= 7/10)"@en ;
    :salience 0 ;
    :usesEvidence :E_53,
        :E_59 ;
    dct:source :Src_ddxplus2022 ;
    rdfs:comment "DDXPlus asks how fast the pain appeared on a 0-10 scale; >= 7 is read as abrupt."@en .

:Rule_A-AFRISK a :AbstractionRule ;
    rdfs:label "Risk factors for atrial fibrillation"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_AFRiskFactors ] ;
    :certaintyFactor 1.0 ;
    :code "A-AFRISK" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AnyOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_104 ] [ a :EvidencePresent ;
                        :onEvidence :E_19 ] [ a :EvidencePresent ;
                        :onEvidence :E_22 ] [ a :EvidencePresent ;
                        :onEvidence :E_106 ] [ a :EvidencePresent ;
                        :onEvidence :E_69 ] [ a :EvidencePresent ;
                        :onEvidence :E_105 ] [ a :EvidencePresent ;
                        :onEvidence :E_70 ] [ a :EvidencePresent ;
                        :onEvidence :E_31 ] [ a :EvidencePresent ;
                        :onEvidence :E_139 ] [ a :EvidencePresent ;
                        :onEvidence :E_78 ] ) ] ;
    :ruleIndex 51 ;
    :ruleText "IF High blood pressure or do you take medications to treat high blood pressure OR Hyperthyroidism OR Known issue with one of your heart valves OR Heart failure OR Diabetes OR Heart attack or do you have angina (chest pain) OR Significantly overweight compared to people of the same height as you OR Severe Chronic Obstructive Pulmonary Disease (COPD) OR Known heart defect OR Drink alcohol excessively or do you have an addiction to alcohol THEN Risk factors for atrial fibrillation"@en ;
    :salience 0 ;
    :usesEvidence :E_104,
        :E_105,
        :E_106,
        :E_139,
        :E_19,
        :E_22,
        :E_31,
        :E_69,
        :E_70,
        :E_78 ;
    dct:source :Src_hindricks2021 .

:Rule_A-AIRWAY a :AbstractionRule ;
    rdfs:label "Upper-airway obstruction signs"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_UpperAirwayObstructionSigns ] ;
    :certaintyFactor 1.0 ;
    :code "A-AIRWAY" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AtLeast ;
            :minCount 2 ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_190 ] [ a :EvidencePresent ;
                        :onEvidence :E_65 ] [ a :EvidencePresent ;
                        :onEvidence :E_212 ] [ a :EvidencePresent ;
                        :onEvidence :E_66 ] [ a :EvidencePresent ;
                        :onEvidence :E_194 ] ) ] ;
    :ruleIndex 28 ;
    :ruleText "IF at least 2 of [You produce more saliva than usual; Difficulty swallowing, or have a feeling of discomfort/blockage when swallowing; Tone of your voice has become deeper, softer or hoarse; Experiencing shortness of breath or difficulty breathing in a significant way; High pitched sound when breathing in] THEN Signs of upper-airway obstruction (drooling, dysphagia, dysphonia, distress, stridor)"@en ;
    :salience 0 ;
    :usesEvidence :E_190,
        :E_194,
        :E_212,
        :E_65,
        :E_66 ;
    dct:source :Src_guldfred2008 ;
    rdfs:comment "Drooling, dysphagia, dysphonia, distress and stridor: the warning signs of acute epiglottitis."@en .

:Rule_A-ANAEMIA a :AbstractionRule ;
    rdfs:label "Symptoms of anaemia"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_AnaemiaSymptoms ] ;
    :certaintyFactor 1.0 ;
    :code "A-ANAEMIA" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_154 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_88 ] [ a :EvidencePresent ;
                                    :onEvidence :E_89 ] [ a :EvidencePresent ;
                                    :onEvidence :E_64 ] [ a :EvidencePresent ;
                                    :onEvidence :E_76 ] [ a :EvidencePresent ;
                                    :onEvidence :E_82 ] ) ] ) ] ;
    :ruleIndex 44 ;
    :ruleText "IF Skin much paler than usual AND (So tired that you are unable to do your usual activities or are you stuck in your bed all day long OR Constantly feel fatigued or do you have non-restful sleep OR Out of breath with minimal physical effort OR Slightly dizzy or lightheaded OR Lightheaded and dizzy or do you feel like you are about to faint) THEN Pallor with fatigue, exertional dyspnoea or light-headedness"@en ;
    :salience 0 ;
    :usesEvidence :E_154,
        :E_64,
        :E_76,
        :E_82,
        :E_88,
        :E_89 ;
    dct:source :Src_cappellini2020 .

:Rule_A-ANAEMIA-RISK a :AbstractionRule ;
    rdfs:label "Risk factors for anaemia"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_AnaemiaRiskFactors ] ;
    :certaintyFactor 1.0 ;
    :code "A-ANAEMIA-RISK" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AnyOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_145 ] [ a :ConceptHolds ;
                        :onConcept :C_GastrointestinalBleeding ] [ a :EvidencePresent ;
                        :onEvidence :E_7 ] [ a :EvidencePresent ;
                        :onEvidence :E_24 ] [ a :EvidencePresent ;
                        :onEvidence :E_26 ] ) ] ;
    :ruleIndex 45 ;
    :ruleText "IF Very abundant or very long menstruation periods OR Gastrointestinal bleeding (melaena, haematochezia, haematemesis) OR Poor diet OR Diagnosis of anemia OR Family members who have been diagnosed with anemia THEN Blood loss, poor diet or known anaemia"@en ;
    :salience 0 ;
    :usesConcept :C_GastrointestinalBleeding ;
    :usesEvidence :E_145,
        :E_24,
        :E_26,
        :E_7 ;
    dct:source :Src_cappellini2020 .

:Rule_A-ANGIO a :AbstractionRule ;
    rdfs:label "Facial swelling"@en ;
    :asserts [ a :ConceptConsequent ;
            :concludesConcept :C_FacialSwelling ] ;
    :certaintyFactor 1.0 ;
    :code "A-ANGIO" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_151 ] [ a :AnswerIn ;
                        :inValueSet :VS_FACE_LIPS_TONGUE ;
                        :onEvidence :E_152 ] ) ] ;
    :ruleIndex 16 ;
    :ruleText "IF Swelling in one or more areas of your body AND Where is the swelling located ∈ {Face, lips, tongue or eyes} THEN Swelling of the face, lips, tongue or eyes (angio-oedema)"@en ;
    :salience 0 ;
    :usesEvidence :E_151,
        :E_152 ;
    dct:source :Src_sampson2006 .

:Rule_A-ASTHMA a :AbstractionRule ;
    rdfs:label "Known asthma"@en ;
    :asserts [ a :ConceptConsequent ;
