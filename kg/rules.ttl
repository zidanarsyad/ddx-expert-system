:Rule_D-VPH-1 a :DiagnosticRule ;
    rdfs:label "Viral pharyngitis: sore throat with cough or coryza (Centor / IDSA)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :ViralPharyngitis ] ;
    :certaintyFactor 0.5 ;
    :code "D-VPH-1" ;
