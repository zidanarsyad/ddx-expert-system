                                    :onEvidence :E_76 ] [ a :EvidencePresent ;
                                    :onEvidence :E_82 ] [ a :ConceptHolds ;
                                    :onConcept :C_StimulantUse ] ) ] ) ] ;
    :ruleIndex 119 ;
    :ruleText "IF Palpitations that are not irregular AND (Slightly dizzy or lightheaded OR Lightheaded and dizzy or do you feel like you are about to faint OR Caffeine, energy drinks, stimulants or decongestants) THEN PSVT (CF +0.50)"@en ;
    :salience 0 ;
    :usesConcept :C_RegularPalpitations,
