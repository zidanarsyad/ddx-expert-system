    :ruleText "IF Heart-failure symptoms (Framingham-style criteria) AND (Heart failure OR Heart attack or do you have angina (chest pain) OR High blood pressure or do you take medications to treat high blood pressure OR Fluid in your lungs OR Undergo dialysis) THEN Acute pulmonary edema (CF +0.60)"@en ;
    :salience 0 ;
