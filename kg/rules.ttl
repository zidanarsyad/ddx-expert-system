:Rule_D-AOM-1 a :DiagnosticRule ;
    rdfs:label "Acute otitis media: ear pain with fever, coryza or cough"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :AcuteOtitisMedia ] ;
    :certaintyFactor 0.6 ;
