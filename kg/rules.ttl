    :salience 0 ;
    :usesConcept :C_Atopy,
        :C_KnownCOPD ;
    :usesEvidence :E_214,
        :E_66 ;
    dct:source :Src_reddel2022 .

:Rule_D-BOE-1 a :DiagnosticRule ;
    rdfs:label "Boerhaave: repeated vomiting followed by chest or epigastric pain (Mackler)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Boerhaave ] ;
    :certaintyFactor 0.6 ;
    :code "D-BOE-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_211 ] [ a :AnyOf ;
                        :operands ( [ a :ConceptHolds ;
                                    :onConcept :C_ChestPain ] [ a :ConceptHolds ;
                                    :onConcept :C_EpigastricPain ] ) ] ) ] ;
    :ruleIndex 79 ;
    :ruleText "IF Vomited several times or have you made several efforts to vomit AND (Chest pain OR Epigastric pain) THEN Boerhaave (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_ChestPain,
        :C_EpigastricPain ;
    :usesEvidence :E_211 ;
    dct:source :Src_soreide2011 ;
    rdfs:comment "Mackler's triad: vomiting, lower thoracic pain and subcutaneous emphysema; emphysema is an examination finding."@en .

:Rule_D-BOE-2 a :DiagnosticRule ;
    rdfs:label "Boerhaave: heavy alcohol use or haematemesis with vomiting"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Boerhaave ] ;
    :certaintyFactor 0.2 ;
