:Rule_D-SCO-1 a :DiagnosticRule ;
    rdfs:label "Scombroid: dark-fleshed fish followed by flushing, rash, diarrhoea or palpitations"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :ScombroidFoodPoisoning ] ;
    :certaintyFactor 0.8 ;
    :code "D-SCO-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_187 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_92 ] [ a :EvidencePresent ;
                                    :onEvidence :E_129 ] [ a :EvidencePresent ;
                                    :onEvidence :E_51 ] [ a :EvidencePresent ;
                                    :onEvidence :E_155 ] ) ] ) ] ;
    :ruleIndex 65 ;
    :ruleText "IF Eat dark-fleshed fish (such as tuna) or Swiss cheese before the reaction occurred AND (Cheeks suddenly turn red OR Lesions, redness or problems on your skin that you believe are related to the condition you are consulting for OR Diarrhea or an increase in stool frequency OR Heart is beating fast (racing), irregularly (missing a beat) or do you feel palpitations) THEN Scombroid food poisoning (CF +0.80)"@en ;
    :salience 0 ;
    :usesEvidence :E_129,
        :E_155,
        :E_187,
        :E_51,
        :E_92 ;
    dct:source :Src_feng2016 .

:Rule_D-SCO-2 a :DiagnosticRule ;
    rdfs:label "Scombroid argues against anaphylaxis when no allergen contact is reported"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Anaphylaxis ] ;
    :certaintyFactor -0.5 ;
    :code "D-SCO-2" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_187 ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_42 ] ] ) ] ;
    :ruleIndex 66 ;
    :ruleText "IF Eat dark-fleshed fish (such as tuna) or Swiss cheese before the reaction occurred AND NOT In contact with or ate something that you have an allergy to THEN Anaphylaxis (CF -0.50)"@en ;
    :salience 0 ;
    :usesEvidence :E_187,
        :E_42 ;
    dct:source :Src_feng2016 ;
    rdfs:comment "Histamine fish poisoning is a pseudo-allergic reaction that mimics an allergic one."@en .

:Rule_D-SLE-1 a :DiagnosticRule ;
