    rdfs:comment "Cough duration (>= 2 weeks) and night sweats are not asked as such; 'significantly increased sweating' is the closest question."@en .

:Rule_D-TB-2 a :DiagnosticRule ;
    rdfs:label "Tuberculosis: cough with fever, weight loss or haemoptysis in a risk group"@en ;
    :asserts [ a :DiagnosisConsequent ;
