    :ruleText "IF Vomited several times or have you made several efforts to vomit AND (Drink alcohol excessively or do you have an addiction to alcohol OR Recently thrown up blood or something resembling coffee beans) THEN Boerhaave (CF +0.20)"@en ;
    :salience 0 ;
    :usesEvidence :E_210,
        :E_211,
        :E_78 ;
    dct:source :Src_soreide2011 .

:Rule_D-BRL-1 a :DiagnosticRule ;
    rdfs:label "Bronchiolitis: infant with rhinitis and wheeze, increased effort or apnoea (AAP 2014)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Bronchiolitis ] ;
    :certaintyFactor 0.8 ;
    :code "D-BRL-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :AgeComparison ;
                        :comparator "lt" ;
                        :threshold 2.0 ] [ a :EvidencePresent ;
                        :onEvidence :E_181 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_214 ] [ a :EvidencePresent ;
                                    :onEvidence :E_66 ] [ a :EvidencePresent ;
                                    :onEvidence :E_23 ] ) ] ) ] ;
    :ruleIndex 96 ;
    :ruleText "IF age < 2 AND Nasal congestion or a clear runny nose AND (Wheezing sound when you exhale OR Experiencing shortness of breath or difficulty breathing in a significant way OR Ever temporarily stop breathing while you’re asleep) THEN Bronchiolitis (CF +0.80)"@en ;
    :salience 0 ;
    :usesEvidence :E_181,
        :E_214,
        :E_23,
        :E_66 ;
    dct:source :Src_ralston2014 .

:Rule_D-BRO-1 a :DiagnosticRule ;
    rdfs:label "Acute bronchitis: cough with sputum or wheeze, no known COPD"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Bronchitis ] ;
    :certaintyFactor 0.4 ;
    :code "D-BRO-1" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_201 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_77 ] [ a :EvidencePresent ;
                                    :onEvidence :E_214 ] ) ] [ a :Not ;
                        :operand [ a :ConceptHolds ;
                                :onConcept :C_KnownCOPD ] ] ) ] ;
    :ruleIndex 99 ;
    :ruleText "IF Cough AND (Cough that produces colored or more abundant sputum than usual OR Wheezing sound when you exhale) AND NOT Known COPD THEN Bronchitis (CF +0.40)"@en ;
    :salience 0 ;
    :usesConcept :C_KnownCOPD ;
    :usesEvidence :E_201,
        :E_214,
        :E_77 ;
    dct:source :Src_wenzel2006 .

:Rule_D-BRX-1 a :DiagnosticRule ;
    rdfs:label "Bronchiectasis: chronic productive cough with a predisposing condition (ERS 2017)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Bronchiectasis ] ;
    :certaintyFactor 0.6 ;
    :code "D-BRX-1" ;
