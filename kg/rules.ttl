:Rule_D-STA-1 a :DiagnosticRule ;
    rdfs:label "Typical angina: chest pain on exertion relieved by rest (ESC 2019)"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :StableAngina ] ;
    :certaintyFactor 0.6 ;
    :code "D-STA-1" ;
    :mappingFidelity "partial" ;
    :premise [ a :AllOf ;
            :operands ( [ a :ConceptHolds ;
                        :onConcept :C_ChestPain ] [ a :EvidencePresent ;
                        :onEvidence :E_218 ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_14 ] ] [ a :Not ;
                        :operand [ a :EvidencePresent ;
                                :onEvidence :E_13 ] ] ) ] ;
    :ruleIndex 67 ;
    :ruleText "IF Chest pain AND Symptoms that are increased with physical exertion but alleviated with rest AND NOT Chest pain even at rest AND NOT Find that your symptoms have worsened over the last 2 weeks and that progressively less effort is required to cause the symptoms THEN Stable angina (CF +0.60)"@en ;
    :salience 0 ;
    :usesConcept :C_ChestPain ;
    :usesEvidence :E_13,
        :E_14,
        :E_218 ;
    dct:source :Src_knuuti2020 ;
    rdfs:comment "Typical angina has three characteristics: constricting retrosternal discomfort, provoked by exertion, relieved by rest or nitrates within 5 min. The 5-minute relief and nitrates are not asked."@en .

:Rule_D-SVT-1 a :DiagnosticRule ;
    rdfs:label "PSVT: regular palpitations with light-headedness or a stimulant trigger (ESC 2019)"@en ;
    :asserts [ a :DiagnosisConsequent ;
