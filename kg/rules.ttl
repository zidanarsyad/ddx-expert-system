    :premise [ a :AllOf ;
            :operands ( [ a :EvidencePresent ;
                        :onEvidence :E_201 ] [ a :EvidencePresent ;
                        :onEvidence :E_77 ] [ a :AnyOf ;
                        :operands ( [ a :EvidencePresent ;
                                    :onEvidence :E_18 ] [ a :EvidencePresent ;
                                    :onEvidence :E_118 ] [ a :EvidencePresent ;
                                    :onEvidence :E_47 ] [ a :EvidencePresent ;
                                    :onEvidence :E_20 ] [ a :EvidencePresent ;
                                    :onEvidence :E_227 ] ) ] ) ] ;
    :ruleIndex 106 ;
    :ruleText "IF Cough AND Cough that produces colored or more abundant sputum than usual AND (Cystic fibrosis OR Pneumonia OR Crohn’s disease or ulcerative colitis (UC) OR Rheumatoid Arthritis OR Immunosuppressed) THEN Bronchiectasis (CF +0.60)"@en ;
    :salience 0 ;
    :usesEvidence :E_118,
        :E_18,
        :E_20,
        :E_201,
        :E_227,
        :E_47,
        :E_77 ;
    dct:source :Src_polverino2017 .

:Rule_D-BRX-2 a :DiagnosticRule ;
    rdfs:label "Bronchiectasis: haemoptysis with purulent sputum"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :Bronchiectasis ] ;
    :certaintyFactor 0.2 ;
    :code "D-BRX-2" ;
