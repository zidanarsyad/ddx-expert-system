:Rule_D-AST-2 a :DiagnosticRule ;
    rdfs:label "Bronchospasm: wheeze and dyspnoea in an atopic patient without COPD"@en ;
    :asserts [ a :DiagnosisConsequent ;
            :concludesPathology :BronchospasmAcuteAsthmaExacerbation ] ;
