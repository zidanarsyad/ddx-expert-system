    rdfs:comment "Cough, rhinorrhoea, hoarseness or oral ulcers strongly suggest a viral cause; absence of cough is a Centor criterion for streptococcal pharyngitis."@en .

:Rule_R-ACS a :RecommendationRule ;
    rdfs:label "Suspected ACS: ECG and troponin"@en ;
    :asserts [ a :RecommendationConsequent ;
            :concludesRecommendation :REC_ECG_TROPONIN ] ;
    :certaintyFactor 1.0 ;
    :code "R-ACS" ;
    :mappingFidelity "faithful" ;
    :premise [ a :AnyOf ;
            :operands ( [ a :BeliefAtLeast ;
                        :onPathology :PossibleNSTEMISTEMI ;
                        :threshold 0.4 ] [ a :BeliefAtLeast ;
                        :onPathology :UnstableAngina ;
                        :threshold 0.4 ] ) ] ;
    :ruleIndex 167 ;
    :ruleText "IF P(Possible NSTEMI / STEMI) ≥ 0.4 OR P(Unstable angina) ≥ 0.4 THEN recommend: 12-lead ECG within 10 minutes of first medical contact and high-sensitivity troponin (CF +1.00)"@en ;
    :salience 0 ;
    :usesPathology :PossibleNSTEMISTEMI,
        :UnstableAngina ;
    dct:source :Src_byrne2023 .

:Rule_R-ADR a :RecommendationRule ;
